// ─────────────────────────────────────────────────────────────────────────────
// 6G-DALI MLOps Service Layer — Full Schema (all domains)
// ─────────────────────────────────────────────────────────────────────────────
// Origin legend (notes):
//   [28.105]      — directly from TS 28.105
//   [28.105 Top]  — Top IOC fields (TS 28.622 Top, baseline for TS 28.105)
//   [DALI ext]    — DALI extension of an existing standard attribute
//   [DALI new]    — new field introduced by DALI
//   [DALI-MAP]    — 6G-DALI-MAP metadata profile (MLDCAT-AP 2.0 subset)
// ─────────────────────────────────────────────────────────────────────────────
// Domains: Administration · Testbed · Model Catalogue · Training ·
//          Deployment · HPO · Orchestrator
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// AUTHENTICATION & ADMINISTRATION DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

Table users [note: 'DALI-specific — no analogue in TS 28.105 / TS 23.482. Identity is federated: the record mirrors a Keycloak account and holds no credential material.'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  username        varchar     [not null, unique, note: '[DALI new]']
  email           varchar     [not null, unique, note: '[DALI new]']
  keycloak_sub    varchar     [unique, note: '[DALI new] OIDC subject of the linked Keycloak account']
  role            varchar     [not null, default: 'experimenter', note: '[DALI new] admin | experimenter']
  is_active       boolean     [not null, default: true, note: '[DALI new]']
}

Table projects [note: 'DALI Administration domain — resource-scoping construct, no analogue in TS 28.105'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  name            varchar     [not null, unique, note: '[DALI new]']
  description     varchar     [note: '[DALI new]']
  owner_id        uuid        [not null, ref: > users.id, note: '[DALI new]']
}

Table project_memberships [note: 'DALI new — join table user ↔ project'] {
  user_id         uuid        [pk, ref: > users.id, note: '[DALI new]']
  project_id      uuid        [pk, ref: > projects.id, note: '[DALI new]']
  joined_at       timestamp   [not null, note: '[DALI new]']
}

Table access_policies [note: 'DALI new — fine-grained ABAC grants on top of project membership'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  user_id         uuid        [not null, ref: > users.id, note: '[DALI new]']
  project_id      uuid        [not null, ref: > projects.id, note: '[DALI new]']
  can_read        boolean     [not null, default: true, note: '[DALI new]']
  can_write       boolean     [not null, default: false, note: '[DALI new]']
  can_delete      boolean     [not null, default: false, note: '[DALI new]']
  resource_type   varchar     [not null, note: '[DALI new] testbed | model | dataset | training | deployment']
  resource_id     uuid        [note: '[DALI new] null = all resources of the type in the project']
}

// ─────────────────────────────────────────────────────────────────────────────
// TESTBED DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

Table testbeds [note: 'DALI new — extends the AIMLE client concept from TS 23.482'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  name            varchar     [not null, unique, note: '[DALI new]']
  description     text        [note: '[DALI new]']
  location        varchar     [note: '[DALI new]']
  status          varchar     [not null, default: 'online', note: '[DALI new] online | offline | maintenance']
  is_public       boolean     [not null, default: false, note: '[DALI new] true = usable by every authenticated user, bypassing project association']
}

Table testbed_project_associations [note: 'DALI new — M2M join: which projects may use a testbed'] {
  testbed_id      uuid        [pk, ref: > testbeds.id, note: '[DALI new]']
  project_id      uuid        [pk, ref: > projects.id, note: '[DALI new]']
  associated_at   timestamp   [not null, note: '[DALI new]']
}

Table hw_capabilities [note: 'DALI new — 1-to-1 with Testbed'] {
  id                uuid        [pk, note: '[28.105 Top]']
  created_at        timestamp   [not null, note: '[28.105 Top]']
  updated_at        timestamp   [not null, note: '[28.105 Top]']
  managed_by        varchar     [note: '[28.105 Top]']
  testbed_id        uuid        [not null, unique, ref: > testbeds.id, note: '[DALI new]']
  ram_gb            float       [not null, default: 0, note: '[DALI new]']
  storage_gb        float       [not null, default: 0, note: '[DALI new]']
  cpu_cores         int         [not null, default: 0, note: '[DALI new]']
  cpu_model         varchar     [note: '[DALI new]']
  gpu_count         int         [not null, default: 0, note: '[DALI new]']
  gpu_model         varchar     [note: '[DALI new]']
  gpu_vram_gb       float       [note: '[DALI new]']
  last_refreshed_at varchar     [note: '[DALI new]']
}

Table ml_tools_stacks [note: 'DALI new — 1-to-1 with Testbed; groups the tools deployed on it'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  testbed_id      uuid        [not null, unique, ref: > testbeds.id, note: '[DALI new]']
}

Table ml_tools [note: 'DALI new — one tool in a testbed stack. Exactly one orchestrator, experiment_tracker and artifact_storage are mandatory; inference_runtime, mlops_orchestrator and hpo are optional.'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  tools_stack_id  uuid        [not null, ref: > ml_tools_stacks.id, note: '[DALI new]']
  tool_type       varchar     [not null, note: '[DALI new] orchestrator | experiment_tracker | artifact_storage | inference_runtime | mlops_orchestrator | hpo']
  name            varchar     [note: '[DALI new]']
  uri             varchar     [not null, note: '[DALI new] service endpoint']
  params          json        [note: '[DALI new] tool-specific configuration, consumed by the resolved plugin']
}

// ─────────────────────────────────────────────────────────────────────────────
// MODEL CATALOGUE DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

Table ml_model_entries [note: 'MLModelCatalogue entry container — DALI new. Stable identity for a model family; holds 1..N ml_models versions, oldest-first, the first being the EMPTY shell.'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  project_id      uuid        [not null, ref: > projects.id, note: '[DALI new]']
  owner_id        uuid        [ref: > users.id, note: '[DALI new] user who registered the entry']
  visibility      varchar     [not null, default: 'project', note: '[DALI new] private | project | public']
}

Table ml_models [note: 'TS 28.105 MLModel IOC — extended. One row per model *version*; versions form a lineage tree under a single entry.'] {
  id                          uuid        [pk, note: '[28.105 Top]']
  created_at                  timestamp   [not null, note: '[28.105 Top]']
  updated_at                  timestamp   [not null, note: '[28.105 Top]']
  managed_by                  varchar     [note: '[28.105 Top]']
  entry_id                    uuid        [not null, ref: > ml_model_entries.id, note: '[DALI new] NOT unique — many versions share one entry']
  // ── TS 28.105 fields ──
  ml_model_id                 varchar     [not null, unique, note: '[28.105] human-readable id, e.g. lstm-v1-project-x']
  ai_ml_inference_name        varchar     [not null, note: '[28.105]']
  ml_model_version            varchar     [not null, note: '[28.105]']
  ml_training_type            varchar     [not null, default: 'initial', note: '[28.105] initial | pre_specialised | fine_tuning | re_training']
  ml_capabilities_info        json        [note: '[28.105]']
  expected_run_time_context   json        [note: '[28.105]']
  training_context            json        [note: '[28.105]']
  run_time_context            json        [note: '[28.105]']
  // ── DALI extensions ──
  lifecycle_state             varchar     [not null, default: 'empty', note: '[DALI ext] empty | trained | validated | archived']
  framework                   varchar     [note: '[DALI new]']
  framework_version           varchar     [note: '[DALI new]']
  architecture                varchar     [note: '[DALI new]']
  input_shape                 json        [note: '[DALI new] input signature — tensor shapes / feature schema']
  output_shape                json        [note: '[DALI new] output signature — tensor shapes / label schema']
  task_type                   varchar     [note: '[DALI new]']
  flops_estimate              float       [note: '[DALI new] from the ML Workload Estimator']
  training_metrics            json        [note: '[DALI new] loss, accuracy, … for trained/pretrained versions']
  artifact_format             varchar     [note: '[DALI new] onnx | pytorch | tensorflow | keras | safetensors | pickle | h5 | other']
  // ── 6G-DALI-MAP / MLDCAT-AP 2.0 ──
  ml_model_type               varchar     [note: '[DALI-MAP] mlModelType — mandatory at API level']
  ml_task                     varchar     [note: '[DALI-MAP] mlTask — mandatory at API level']
  intended_use                text        [note: '[DALI-MAP] plain-text description of intended inference use']
  how_to_use                  text        [note: '[DALI-MAP] snippet / instructions for running the model']
  trained_on_dataset_uri      varchar     [note: '[DALI-MAP] trainedOn — mandatory for non-EMPTY versions']
  issued_at                   timestamp   [note: '[DALI-MAP] dcterms:issued — when this version was first published']
  // ── Provenance & lineage ──
  issuer_id                   uuid        [ref: > users.id, note: '[DALI new] user who created/uploaded this version']
  parent_model_id             uuid        [ref: > ml_models.id, note: '[DALI new] lineage — parent version']
  training_request_id         uuid        [ref: > ml_training_requests.id, note: '[DALI new] training run that produced this version']
}

Table ml_model_artifacts [note: 'DALI new — version-scoped artifact store. Replaces the former onnx_path / weights_path columns on ml_models. Keyed models/{entry_id}/versions/{model_id}/{kind}/{name}; exactly one of s3_key or uri is set.'] {
  id                uuid        [pk, note: '[28.105 Top]']
  created_at        timestamp   [not null, note: '[28.105 Top]']
  updated_at        timestamp   [not null, note: '[28.105 Top]']
  managed_by        varchar     [note: '[28.105 Top]']
  model_id          uuid        [not null, ref: > ml_models.id, note: '[DALI new]']
  kind              varchar     [not null, note: '[DALI new] flow | weights | requirements | base_image | training_pipeline | hpo_train_script | hpo_requirements | hpo_base_image | docs | other']
  name              varchar     [not null, note: '[DALI new]']
  s3_key            varchar     [note: '[DALI new] set for uploaded files']
  uri               varchar     [note: '[DALI new] set for external references, e.g. a Docker image']
  content_type      varchar     [note: '[DALI new]']
  size_bytes        int         [note: '[DALI new]']
  checksum_sha256   varchar     [note: '[DALI new]']
  format            varchar     [note: '[DALI new]']
  upload_state      varchar     [not null, default: 'pending', note: '[DALI new] pending | uploaded']
  is_primary        boolean     [not null, default: false, note: '[DALI new] the canonical artifact for its kind']
  artifact_metadata json        [note: '[DALI new]']
  uploaded_by_id    uuid        [ref: > users.id, note: '[DALI new]']

  indexes {
    (model_id, kind, name) [unique, name: 'uq_artifact_model_kind_name']
  }
}

Table ml_model_metadata [note: 'Discovery metadata — DALI new. 1-to-1 with the catalogue entry, kept apart to keep the core record lean.'] {
  id                          uuid        [pk, note: '[28.105 Top]']
  created_at                  timestamp   [not null, note: '[28.105 Top]']
  updated_at                  timestamp   [not null, note: '[28.105 Top]']
  managed_by                  varchar     [note: '[28.105 Top]']
  entry_id                    uuid        [not null, unique, ref: > ml_model_entries.id, note: '[DALI new]']
  description                 text        [note: '[DALI new]']
  tags                        json        [note: '[DALI new]']
  license                     varchar     [note: '[DALI new]']
  author                      varchar     [note: '[DALI new] auto-populated from the issuing user']
  training_duration_seconds   float       [note: '[DALI new]']
  hyperparameters             json        [note: '[DALI new]']
  custom_properties           json        [note: '[DALI new]']
  // ── 6G-DALI-MAP compliance flags ──
  gdpr_compliant              boolean     [not null, default: false, note: '[DALI-MAP] dali:gdprCompliant']
  fair_compliant              boolean     [not null, default: false, note: '[DALI-MAP] dali:fairCompliant']
  sns_project_name            varchar     [note: '[DALI-MAP] dali:snsProjectName, e.g. 6G-DALI']
  access_rights               varchar     [note: '[DALI-MAP] dcterms:accessRights, e.g. public | restricted']
}

Table datasets [note: 'DALI new — first-class dataset entity in the catalogue'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  project_id      uuid        [not null, ref: > projects.id, note: '[DALI new]']
  owner_id        uuid        [ref: > users.id, note: '[DALI new]']
  name            varchar     [not null, note: '[DALI new]']
  description     text        [note: '[DALI new]']
  s3_uri          varchar     [not null, note: '[DALI new]']
  format          varchar     [note: '[DALI new]']
  num_samples     int         [note: '[DALI new]']
  visibility      varchar     [not null, default: 'project', note: '[DALI new] private | project | public']

  indexes {
    (project_id, name) [unique, name: 'uq_dataset_project_name']
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINING DOMAIN  —  TS 28.105 MLTrainingFunction triple
// ─────────────────────────────────────────────────────────────────────────────

Table ml_training_requests [note: 'TS 28.105 MLTrainingRequest IOC — extended'] {
  id                      uuid        [pk, note: '[28.105 Top]']
  created_at              timestamp   [not null, note: '[28.105 Top]']
  updated_at              timestamp   [not null, note: '[28.105 Top]']
  managed_by              varchar     [note: '[28.105 Top]']
  source                  varchar     [not null, default: 'experimenter', note: '[28.105] trainingRequestSource — experimenter | system']
  status                  varchar     [not null, default: 'not_started', note: '[28.105] requestStatus']
  name                    varchar     [not null, note: '[DALI new]']
  description             text        [note: '[DALI new]']
  optimization_goal       varchar     [not null, default: 'balanced', note: '[DALI ext] time | energy | accuracy | balanced']
  training_config         json        [note: '[DALI ext] extends trainingContext']
  dataset_info            json        [note: '[DALI ext] extends the dataset reference']
  required_capabilities   json        [note: '[DALI new] forwarded to the Task Placement Engine']
  rejection_reason        text        [note: '[DALI new]']
  project_id              uuid        [not null, ref: > projects.id, note: '[DALI new]']
  submitted_by_id         uuid        [ref: > users.id, note: '[DALI new]']
  testbed_id              uuid        [ref: > testbeds.id, note: '[DALI new]']
  target_model_entry_id   uuid        [ref: > ml_model_entries.id, note: '[DALI new]']
  source_hpo_report_id    uuid        [ref: > hpo_reports.id, note: '[DALI new] HPO report whose best config seeded this request']
}

Table ml_training_processes [note: 'TS 28.105 MLTrainingProcess IOC — extended'] {
  id                          uuid        [pk, note: '[28.105 Top]']
  created_at                  timestamp   [not null, note: '[28.105 Top]']
  updated_at                  timestamp   [not null, note: '[28.105 Top]']
  managed_by                  varchar     [note: '[28.105 Top]']
  status                      varchar     [not null, default: 'initializing', note: '[28.105] progressStatus']
  started_at                  timestamp   [note: '[28.105]']
  ended_at                    timestamp   [note: '[28.105]']
  progress_percentage         float       [note: '[28.105]']
  log_url                     varchar     [note: '[DALI new]']
  external_ref                json        [note: '[DALI new] plugin name + tool-specific ids/urls, e.g. {plugin: zenml, run_id: …}. Supersedes orchestrator_flow_run_id.']
  orchestrator_decision       json        [note: '[DALI new] snapshot of the environment-selection decision (available_envs, selected_env, workload_estimate)']
  request_id                  uuid        [not null, unique, ref: > ml_training_requests.id, note: '[DALI new]']
  testbed_id                  uuid        [not null, ref: > testbeds.id, note: '[DALI new]']
}

Table ml_training_reports [note: 'TS 28.105 MLTrainingReport IOC — extended'] {
  id                          uuid        [pk, note: '[28.105 Top]']
  created_at                  timestamp   [not null, note: '[28.105 Top]']
  updated_at                  timestamp   [not null, note: '[28.105 Top]']
  managed_by                  varchar     [note: '[28.105 Top]']
  outcome                     varchar     [not null, note: '[28.105] success | failure | cancelled']
  duration_seconds            float       [note: '[28.105]']
  final_metrics               json        [note: '[DALI ext] extends performanceRequirements']
  artifacts                   json        [note: '[DALI new] extra artifact references (name → URI) reported alongside the weights']
  experiment_id               varchar     [note: '[DALI new] id in the testbed experiment tracker']
  error_message               text        [note: '[DALI new]']
  process_id                  uuid        [not null, unique, ref: > ml_training_processes.id, note: '[DALI new]']
  request_id                  uuid        [not null, unique, ref: > ml_training_requests.id, note: '[DALI new]']
  produced_model_entry_id     uuid        [ref: > ml_model_entries.id, note: '[DALI new] produced artefact lineage — entry']
  produced_model_id           uuid        [ref: > ml_models.id, note: '[DALI new] produced artefact lineage — exact version']
}

// ─────────────────────────────────────────────────────────────────────────────
// DEPLOYMENT DOMAIN  —  DALI new (no analogue in TS 28.105 for general serving)
// ─────────────────────────────────────────────────────────────────────────────

Table ml_deployment_requests [note: 'DALI new — MLDeploymentFunction, modelled on the TS 28.105 request triple'] {
  id                      uuid        [pk, note: '[28.105 Top]']
  created_at              timestamp   [not null, note: '[28.105 Top]']
  updated_at              timestamp   [not null, note: '[28.105 Top]']
  managed_by              varchar     [note: '[28.105 Top]']
  name                    varchar     [not null, note: '[DALI new]']
  description             text        [note: '[DALI new]']
  status                  varchar     [not null, default: 'not_started', note: '[DALI ext] requestStatus vocabulary']
  serving_runtime         varchar     [not null, default: 'onnx_runtime', note: '[DALI new] onnx_runtime | triton | torchserve | custom']
  deployment_strategy     varchar     [not null, default: 'replace', note: '[DALI new] replace | blue_green | canary']
  optimization_goal       varchar     [not null, default: 'latency', note: '[DALI new] latency | throughput | cost']
  deployment_config       json        [note: '[DALI new] replicas, resource limits, env vars']
  rejection_reason        text        [note: '[DALI new]']
  project_id              uuid        [not null, ref: > projects.id, note: '[DALI new]']
  submitted_by_id         uuid        [ref: > users.id, note: '[DALI new]']
  model_entry_id          uuid        [not null, ref: > ml_model_entries.id, note: '[DALI new] catalogue entry being deployed']
  model_id                uuid        [ref: > ml_models.id, note: '[DALI new] exact version pinned at submission time']
  testbed_id              uuid        [ref: > testbeds.id, note: '[DALI new]']
}

Table ml_deployment_processes [note: 'DALI new — stays RUNNING for as long as the model is live'] {
  id                          uuid        [pk, note: '[28.105 Top]']
  created_at                  timestamp   [not null, note: '[28.105 Top]']
  updated_at                  timestamp   [not null, note: '[28.105 Top]']
  managed_by                  varchar     [note: '[28.105 Top]']
  status                      varchar     [not null, default: 'initializing', note: '[DALI ext] initializing | deploying | running | stopping | stopped | failed | cancelled']
  started_at                  timestamp   [note: '[DALI ext]']
  ended_at                    timestamp   [note: '[DALI ext]']
  progress_percentage         float       [note: '[DALI ext]']
  log_url                     varchar     [note: '[DALI new]']
  external_ref                json        [note: '[DALI new] plugin name + tool-specific ids/urls. Supersedes orchestrator_flow_run_id.']
  orchestrator_decision       json        [note: '[DALI new] snapshot of the environment-selection decision']
  request_id                  uuid        [not null, unique, ref: > ml_deployment_requests.id, note: '[DALI new]']
  testbed_id                  uuid        [not null, ref: > testbeds.id, note: '[DALI new]']
}

Table ml_deployment_reports [note: 'DALI new — terminal outcome artefact'] {
  id                          uuid        [pk, note: '[28.105 Top]']
  created_at                  timestamp   [not null, note: '[28.105 Top]']
  updated_at                  timestamp   [not null, note: '[28.105 Top]']
  managed_by                  varchar     [note: '[28.105 Top]']
  outcome                     varchar     [not null, note: '[DALI ext] success | failure | rollback | cancelled']
  duration_seconds            float       [note: '[DALI new] dispatch → ready/terminal, in seconds']
  error_message               text        [note: '[DALI new]']
  serving_backend             varchar     [note: '[DALI new] backend that actually served the model']
  artifact_format             varchar     [note: '[DALI new] format of the artifact that was served']
  final_endpoint              varchar     [note: '[DALI new] endpoint URL at the end of the process']
  process_id                  uuid        [not null, unique, ref: > ml_deployment_processes.id, note: '[DALI new]']
  request_id                  uuid        [not null, unique, ref: > ml_deployment_requests.id, note: '[DALI new]']
  deployed_model_id           uuid        [ref: > deployed_ml_models.id, note: '[DALI new]']
}

Table deployed_ml_models [note: 'DALI new — live serving endpoint record'] {
  id                          uuid        [pk, note: '[28.105 Top]']
  created_at                  timestamp   [not null, note: '[28.105 Top]']
  updated_at                  timestamp   [not null, note: '[28.105 Top]']
  managed_by                  varchar     [note: '[28.105 Top]']
  serving_runtime             varchar     [not null, note: '[DALI new]']
  inference_endpoint_url      varchar     [note: '[DALI new] HTTP(S) inference endpoint']
  status                      varchar     [not null, default: 'running', note: '[DALI new] running | stopped | error | degraded']
  health_status               varchar     [not null, default: 'unknown', note: '[DALI new] healthy | unhealthy | unknown']
  replicas_desired            int         [not null, default: 1, note: '[DALI new]']
  replicas_running            int         [not null, default: 0, note: '[DALI new]']
  last_health_check_at        timestamp   [note: '[DALI new]']
  deployment_config           json        [note: '[DALI new]']
  input_shapes                json        [note: '[DALI new] input tensor shapes as reported by the serving backend']
  output_shapes               json        [note: '[DALI new] output tensor shapes as reported by the serving backend']
  backend_metadata            json        [note: '[DALI new] free-form backend metadata, e.g. KServe v2 model metadata']
  model_entry_id              uuid        [not null, ref: > ml_model_entries.id, note: '[DALI new]']
  ml_model_id                 uuid        [ref: > ml_models.id, note: '[DALI new] the exact version being served here']
  testbed_id                  uuid        [not null, ref: > testbeds.id, note: '[DALI new]']
  deployment_request_id       uuid        [ref: > ml_deployment_requests.id, note: '[DALI new]']
  process_id                  uuid        [unique, ref: > ml_deployment_processes.id, note: '[DALI new]']
}

// ─────────────────────────────────────────────────────────────────────────────
// HPO DOMAIN  —  DALI new, modelled on the TS 28.105 request triple
// ─────────────────────────────────────────────────────────────────────────────

Table hpo_campaigns [note: 'DALI new — registration-level entity. One model + dataset + train script registered on exactly one testbed HPO platform; holds N runs.'] {
  id                          uuid        [pk, note: '[28.105 Top]']
  created_at                  timestamp   [not null, note: '[28.105 Top]']
  updated_at                  timestamp   [not null, note: '[28.105 Top]']
  managed_by                  varchar     [note: '[28.105 Top]']
  name                        varchar     [not null, note: '[DALI new]']
  description                 text        [note: '[DALI new]']
  status                      varchar     [not null, default: 'draft', note: '[DALI new] draft | registering | registered | failed | archived']
  visibility                  varchar     [not null, default: 'project', note: '[DALI new] private | project | public']
  project_id                  uuid        [not null, ref: > projects.id, note: '[DALI new]']
  owner_id                    uuid        [ref: > users.id, note: '[DALI new]']
  testbed_id                  uuid        [not null, ref: > testbeds.id, note: '[DALI new] a campaign is bound to exactly one testbed']
  target_model_entry_id       uuid        [ref: > ml_model_entries.id, note: '[DALI new]']
  model_id                    uuid        [ref: > ml_models.id, note: '[DALI new] the EMPTY-shell version this campaign optimises']
  dataset_id                  uuid        [ref: > datasets.id, note: '[DALI new]']
  train_script_artifact_id    uuid        [ref: > ml_model_artifacts.id, note: '[DALI new] kind hpo_train_script — required at create time']
  requirements_artifact_id    uuid        [ref: > ml_model_artifacts.id, note: '[DALI new] kind hpo_requirements']
  base_image_artifact_id      uuid        [ref: > ml_model_artifacts.id, note: '[DALI new] kind hpo_base_image']
  external_ref                json        [note: '[DALI new] {plugin: hpo_ado, campaign_id: …}']
  search_space                json        [note: '[DALI new] parsed @parameter space returned at registration']
  objective                   json        [note: '[DALI new] parsed @objective — name + direction']
  registration_raw            json        [note: '[DALI new] untouched registration response, insurance against shape drift']
  registered_at               timestamp   [note: '[DALI new]']
  registration_error          text        [note: '[DALI new]']

  indexes {
    (project_id, name) [unique, name: 'uq_hpo_campaign_project_name']
  }
}

Table hpo_requests [note: 'DALI new — intent to run one optimisation run on a campaign'] {
  id                  uuid        [pk, note: '[28.105 Top]']
  created_at          timestamp   [not null, note: '[28.105 Top]']
  updated_at          timestamp   [not null, note: '[28.105 Top]']
  managed_by          varchar     [note: '[28.105 Top]']
  name                varchar     [not null, note: '[DALI new]']
  description         text        [note: '[DALI new]']
  status              varchar     [not null, default: 'not_started', note: '[DALI ext] requestStatus vocabulary']
  optimizer           varchar     [note: '[DALI new] falls back to the plugin default at accept time']
  num_samples         int         [not null, default: 10, note: '[DALI new] trials to run']
  max_concurrent      int         [not null, default: 1, note: '[DALI new]']
  space_overrides     json        [note: '[DALI new] per-run overrides of the campaign search space']
  campaign_id         uuid        [not null, ref: > hpo_campaigns.id, note: '[DALI new]']
  project_id          uuid        [not null, ref: > projects.id, note: '[DALI new]']
  submitted_by_id     uuid        [ref: > users.id, note: '[DALI new]']
  rejection_reason    text        [note: '[DALI new]']
}

Table hpo_processes [note: 'DALI new — tracks an accepted run on the testbed HPO platform'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  status          varchar     [not null, default: 'initializing', note: '[DALI ext] progressStatus vocabulary']
  started_at      timestamp   [note: '[DALI ext]']
  ended_at        timestamp   [note: '[DALI ext]']
  external_ref    json        [note: '[DALI new] {plugin: hpo_ado, campaign_id: …, run_id: …}']
  request_id      uuid        [not null, unique, ref: > hpo_requests.id, note: '[DALI new]']
  testbed_id      uuid        [not null, ref: > testbeds.id, note: '[DALI new]']
}

Table hpo_reports [note: 'DALI new — best config, metric and trial history once a run reaches a terminal state'] {
  id                          uuid        [pk, note: '[28.105 Top]']
  created_at                  timestamp   [not null, note: '[28.105 Top]']
  updated_at                  timestamp   [not null, note: '[28.105 Top]']
  managed_by                  varchar     [note: '[28.105 Top]']
  outcome                     varchar     [not null, note: '[DALI ext] success | failure | cancelled']
  engine                      varchar     [note: '[DALI new] optimisation engine actually used']
  best                        json        [note: '[DALI new] best trial — {trial, config, <metric>}']
  trials                      json        [note: '[DALI new] full trial history']
  suggested_training_config   json        [note: '[DALI new] config offered to seed a follow-up MLTrainingRequest']
  error_message               text        [note: '[DALI new]']
  duration_seconds            float       [note: '[DALI new]']
  process_id                  uuid        [not null, unique, ref: > hpo_processes.id, note: '[DALI new]']
  request_id                  uuid        [not null, unique, ref: > hpo_requests.id, note: '[DALI new]']
}

// ─────────────────────────────────────────────────────────────────────────────
// ORCHESTRATOR DOMAIN  —  DALI new, internal dispatch plumbing
// ─────────────────────────────────────────────────────────────────────────────

Table dispatch_queue [note: 'DALI new — DB-backed FIFO serialising activate/trigger/poll against a single testbed Control API endpoint'] {
  id              uuid        [pk, note: '[28.105 Top]']
  created_at      timestamp   [not null, note: '[28.105 Top]']
  updated_at      timestamp   [not null, note: '[28.105 Top]']
  managed_by      varchar     [note: '[28.105 Top]']
  endpoint_key    varchar     [not null, note: '[DALI new] Control API base URL — the serialisation unit']
  task_type       varchar     [not null, default: 'training', note: '[DALI new]']
  process_id      uuid        [not null, ref: > ml_training_processes.id, note: '[DALI new]']
  testbed_id      uuid        [not null, ref: > testbeds.id, note: '[DALI new]']
  stack_name      varchar     [not null, note: '[DALI new]']
  pipeline_name   varchar     [not null, note: '[DALI new]']
  parameters      json        [not null, note: '[DALI new]']
  state           varchar     [not null, default: 'queued', note: '[DALI new] queued | activating | triggering | awaiting_start | done | failed']
  attempts        int         [not null, default: 0, note: '[DALI new]']
  enqueued_at     timestamp   [not null, note: '[DALI new]']
  started_at      timestamp   [note: '[DALI new]']
  error           varchar     [note: '[DALI new]']
}

Table pipeline_registrations [note: 'DALI new — per (model, testbed) sync state of a training pipeline registered with a testbed Control API'] {
  id                      uuid        [pk, note: '[28.105 Top]']
  created_at              timestamp   [not null, note: '[28.105 Top]']
  updated_at              timestamp   [not null, note: '[28.105 Top]']
  managed_by              varchar     [note: '[28.105 Top]']
  model_id                uuid        [not null, ref: > ml_models.id, note: '[DALI new]']
  testbed_id              uuid        [not null, ref: > testbeds.id, note: '[DALI new]']
  plugin                  varchar     [not null, note: '[DALI new] plugin that owns the registration, e.g. zenml']
  external_pipeline_name  varchar     [not null, note: '[DALI new]']
  version                 varchar     [note: '[DALI new]']
  state                   varchar     [not null, default: 'pending', note: '[DALI new] pending | registered | failed']
  last_error              varchar     [note: '[DALI new]']
  artifact_id             uuid        [ref: > ml_model_artifacts.id, note: '[DALI new] the training_pipeline artifact registered here — re-register when it changes']

  indexes {
    (model_id, testbed_id) [unique, name: 'uq_pipeline_registration_model_testbed']
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// TABLE GROUPS
// ─────────────────────────────────────────────────────────────────────────────

TableGroup administration {
  users
  projects
  project_memberships
  access_policies
}

TableGroup testbed {
  testbeds
  testbed_project_associations
  hw_capabilities
  ml_tools_stacks
  ml_tools
}

TableGroup model_catalogue {
  ml_model_entries
  ml_models
  ml_model_artifacts
  ml_model_metadata
  datasets
}

TableGroup training {
  ml_training_requests
  ml_training_processes
  ml_training_reports
}

TableGroup deployment {
  ml_deployment_requests
  ml_deployment_processes
  ml_deployment_reports
  deployed_ml_models
}

TableGroup hpo {
  hpo_campaigns
  hpo_requests
  hpo_processes
  hpo_reports
}

TableGroup orchestrator {
  dispatch_queue
  pipeline_registrations
}
