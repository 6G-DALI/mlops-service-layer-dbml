Table ml_training_requests [note: 'Context only — full definition in schema_model_training.dbml'] {
  id      uuid        [pk]
  name    varchar
  status  varchar
}

Table projects [note: 'Context only — full definition in schema_admin.dbml'] {
  id    uuid        [pk]
  name  varchar
}

Table users [note: 'Context only — full definition in schema_admin.dbml'] {
  id        uuid        [pk]
  username  varchar
}
